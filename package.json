{
  "name": "codesync",
  "version": "1.0.0",
  "description": "Sync your LeetCode submissions into a Git repo with original timestamps",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dashboard": "node src/server.js",
    "build:frontend": "cd frontend && npm install && npm run build",
    "dev:server": "node src/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "keywords": ["leetcode", "git", "sync", "dashboard"],
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0"
  }
}
