{
  "name": "codesync",
  "version": "2.0.0",
  "description": "Sync your LeetCode submissions into a Git repo with original timestamps",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "cli": "node src/index.js",
    "build:frontend": "cd frontend && npm install && npm run build",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "keywords": ["leetcode", "git", "sync", "dashboard", "mongodb"],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "4.19.2",
    "express-validator": "7.3.2",
    "mongoose": "9.9.1",
    "node-fetch": "3.3.2",
    "uuid": "14.0.1",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "jest": "29.7.0"
  }
}
