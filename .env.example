# ============================================================================
# CodeSync — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ============================================================================

# ── Required ──────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# 64-char hex string for AES-256-GCM encryption of sensitive fields
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────

# Server port (default: 3055)
PORT=3055

# Node environment (default: development)
NODE_ENV=development

# Public URL of the backend (used for OAuth callbacks)
# For local dev, leave unset (defaults to http://localhost:3055)
# For production (e.g. Render), set to your deployed URL
# BACKEND_URL=https://your-app.onrender.com

# Public URL of the frontend (used for CORS and OAuth redirects)
# For local dev, leave unset (defaults to http://localhost:5173)
# FRONTEND_URL=http://localhost:5173

# ── GitHub OAuth (optional — can also be configured via the dashboard) ────────

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
